<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"			
			 xmlns:vm="clr-namespace:ClientCW.ViewModels"
			 xmlns:ctrl="clr-namespace:ClientCW.Views"             			 
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="1000"
             x:Class="ClientCW.Views.Weight"
			 x:DataType="vm:MainTabViewModel">

	
	<StackPanel Margin="5">
		

		
				
		<Grid ShowGridLines="true"
			  MinHeight="710">
			
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="350"/>				
				<ColumnDefinition Width="*" MinWidth="295"/>				
			</Grid.ColumnDefinitions>
			
			<!-- ЛЕВАЯ часть с картинкой -->
			<Grid Grid.Column="0"
				  RowDefinitions="Auto 10">

				
				
				<StackPanel HorizontalAlignment="Left"
						Grid.Row="0"
						Margin="0 10">
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="{Binding statusData.TimeString}"
							   ToolTip.Tip="Время контроллера весов"
							   Margin="0 0 0 10"/>
					</StackPanel>					
					
					<StackPanel HorizontalAlignment="Center">


						<WrapPanel>
							<TextBlock FontWeight="Bold"
									   HorizontalAlignment="Center"
									   Text="Заказ:"/>
							<TextBlock HorizontalAlignment="Center"
									   Margin="5 0"
									   Text="{Binding staticOrderData.sOrderID}"/>
						</WrapPanel>
						<WrapPanel>
							<TextBlock FontWeight="Bold"
									   HorizontalAlignment="Center"
									   Text="Тип:"/>
							<TextBlock HorizontalAlignment="Center"
									   Margin="5 0"
									   Text="{Binding staticOrderData.sProductName}"/>
						</WrapPanel>
					</StackPanel>

					<!-- ******************** Графическая часть **************  -->
					<Canvas Margin="0 5"
							Height="500"
							Width="300"
							Name="MyCanvas">
					</Canvas>
					<!-- *****************************************************  -->

					<TextBlock Margin="0 5"
							   Padding="20 0"
							   Height="50"
							   TextAlignment ="Center"
							   TextWrapping="Wrap">Статус весов. Еще данные , многотекста и еще амвамав мавмав ам ва мав текст
					</TextBlock>

				</StackPanel>
			

				<Border Grid.Row="1" 
						Background="Black" 
						Width="300" 
						Height="80" 
						Margin="0 10"
						Padding="5"
						IsVisible="true">
					<ScrollViewer>						
						<TextBlock Foreground="Yellow"
								   TextWrapping="Wrap"
								   Text="{Binding statusData.AlarmList}"/>
							
						
					</ScrollViewer>
				</Border>

			</Grid>
			

			<!-- ПРАВАЯ часть - все данные -->
			<Grid Grid.Column="1"
				  Margin="0 0 0 10"
				  MinWidth="295"
				  ShowGridLines="false"
				  ColumnDefinitions="*, *"
				  RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">

				<StackPanel Grid.Column="0" Grid.Row="0">
					<Border Background="#f5f5f5"
							BorderBrush="#ededed"
							BorderThickness="2"
							CornerRadius="3"
							Padding="5" Margin="10">
						<StackPanel>
							<TextBlock FontWeight="Bold"
									   Text="Продукт"/>
							<TextBlock Margin="0 5 0 0"
									   TextAlignment="Center"
									   Text="{Binding staticOrderData.sProductName}"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="1" Grid.Row="0">
					<Border Background="#f5f5f5"
							BorderBrush="#ededed"
							BorderThickness="2"
							CornerRadius="3"
							Padding="5" Margin="10">
						<StackPanel>
							<TextBlock FontWeight="Bold"
									   Text="Заказчик"/>
							<TextBlock Margin="0 5 0 0"
									   TextAlignment="Center"
									   Text="{Binding staticOrderData.sCustomerName}"/>
						</StackPanel>
					</Border>
				</StackPanel>
				
				<StackPanel Grid.Column="0" Grid.Row="1">
					<Border Background="#f5f5f5"
							BorderBrush="#ededed"
							BorderThickness="2"
							CornerRadius="3"
							Padding="5" Margin="10">
						<StackPanel>
							<TextBlock FontWeight="Bold"
									   Text="Вес"/>
							<TextBlock Margin="0 5 0 0"
									   TextAlignment="Center"
									   Text="{Binding statusData.ScaleWeight}"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="1" Grid.Row="1">
					<Border Background="#f5f5f5"
							BorderBrush="#ededed"
							BorderThickness="2"
							CornerRadius="3"
							Padding="5" Margin="10">
						<StackPanel>
							<TextBlock FontWeight="Bold"
									   Text="Отвес"/>
							<TextBlock Margin="0 5 0 0"
									   TextAlignment="Center"
									   Text="{Binding orderData.CurrentDruftCount}"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="0" Grid.Row="2">
					<Border Background="#f5f5f5"
							BorderBrush="#ededed"
							BorderThickness="2"
							CornerRadius="3"
							Padding="5" Margin="10">
						<StackPanel>
							<TextBlock FontWeight="Bold"
									   Text="Общий вес"/>
							<TextBlock Margin="0 5 0 0"
									   TextAlignment="Center"
									   Text="{Binding orderData.TotalWeight}"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="1" Grid.Row="2">
					<Border Background="#f5f5f5"
							BorderBrush="#ededed"
							BorderThickness="2"
							CornerRadius="3"
							Padding="5" Margin="10">
						<StackPanel>
							<TextBlock FontWeight="Bold"
									   Text="Номер отвеса"/>
							<TextBlock Margin="0 5 0 0"
									   TextAlignment="Center"
									   Text="{Binding orderData.CurrentDruftCount}"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="0" Grid.Row="3">
					<Border Background="#f5f5f5"
							BorderBrush="#ededed"
							BorderThickness="2"
							CornerRadius="3"
							Padding="5" Margin="10">
						<StackPanel>
							<TextBlock FontWeight="Bold"
									   Text="Баланс"/>
							<TextBlock Margin="0 5 0 0"
									   TextAlignment="Center"
									   Text="{Binding orderData.OrderBalance}"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="1" Grid.Row="3">
					<Border Background="#f5f5f5"
							BorderBrush="#ededed"
							BorderThickness="2"
							CornerRadius="3"
							Padding="5" Margin="10">
						<StackPanel>
							<TextBlock FontWeight="Bold"
									   Text="Текущий итог"/>
							<TextBlock Margin="0 5 0 0"
									   TextAlignment="Center"
									   Text="{Binding miscStatusData.mRunningTotalWeight}"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.ColumnSpan="2" 
							Grid.Row="4"
							Margin="10">
					<TextBlock FontWeight="Bold"							   
							   Text="Весы"/>

					<Grid ColumnDefinitions="*, 50">
						<StackPanel Grid.Column="0">
							<Border Background="Black"
									BorderBrush="#ededed"
									BorderThickness="2"
									CornerRadius="3"
									Padding="5"
									Margin="0 5">
								<TextBlock  FontSize="20"
											Padding="5 0"
											Foreground="Yellow"
											TextAlignment="Right"
											FontWeight="Bold"
											Text="{Binding statusData.ScaleWeight}"/>
							</Border>
						</StackPanel>						
						<TextBlock Grid.Column="1"
								   FontSize="20"
								   Margin="5 0"
								   VerticalAlignment="Center"
								   FontWeight="Bold"
								   Text="КГ"/>
					</Grid>
				</StackPanel>

				<StackPanel Grid.Column="0" Grid.Row="5">
					<Border Background="#f5f5f5"
							BorderBrush="#ededed"
							BorderThickness="2"
							CornerRadius="3"
							Padding="5" Margin="10">
						<StackPanel>
							<TextBlock FontWeight="Bold"
									   Text="Брутто"/>
							<TextBlock Margin="0 5 0 0"
									   TextAlignment="Center"
									   Text="{Binding orderData.DraftGrossWeight}"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="1" Grid.Row="5">
					<Border Background="#f5f5f5"
							BorderBrush="#ededed"
							BorderThickness="2"
							CornerRadius="3"
							Padding="5" Margin="10">
						<StackPanel>
							<TextBlock FontWeight="Bold"
									   Text="Тара"/>
							<TextBlock Margin="0 5 0 0"
									   TextAlignment="Center"
									   Text="{Binding orderData.DraftTareWeight}"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.ColumnSpan="2"
							Grid.Row="7"
							Margin="10">
					
					<ComboBox SelectedIndex="0" 							 
							  FontWeight="Bold"							  
							  HorizontalAlignment="Right"
							  BorderThickness="0"
							  Name="btnCoimbo1">
						<ComboBoxItem>Баланс</ComboBoxItem>
						<ComboBoxItem>Общий вес</ComboBoxItem>
						<ComboBoxItem>Текущий итог</ComboBoxItem>
					</ComboBox>
					
					<StackPanel Grid.Column="0">
						<Border Background="Black"
								BorderBrush="#ededed"
								BorderThickness="2"
								CornerRadius="3"
								Padding="5"
								Margin="0 5"
								IsVisible="True">
							<TextBlock  FontSize="20"										
										Padding="5 0"
										Foreground="Yellow"
										TextAlignment="Right"
										FontWeight="Bold"
										Name="comboValue1"
										Text="{Binding orderData.TotalWeight}" />
						</Border>						
					</StackPanel>
				</StackPanel>

				<StackPanel Grid.ColumnSpan="2"
							Grid.Row="8"
							Margin="10">

					<ComboBox SelectedIndex="1"
							  FontWeight="Bold"
							  HorizontalAlignment="Right"
							  BorderThickness="0"
							  Name="btnCoimbo2">
						<ComboBoxItem>Баланс</ComboBoxItem>
						<ComboBoxItem>Общий вес</ComboBoxItem>
						<ComboBoxItem>Текущий итог</ComboBoxItem>
					</ComboBox>

					<StackPanel Grid.Column="0">
						<Border Background="Black"
								BorderBrush="#ededed"
								BorderThickness="2"
								CornerRadius="3"
								Padding="5"
								Margin="0 5">
							<TextBlock  FontSize="20"
										Padding="5 0"
										Foreground="Yellow"
										TextAlignment="Right"
										FontWeight="Bold"
										Name="comboValue2"
										Text="{Binding orderData.TotalWeight}" />
						</Border>
					</StackPanel>
				</StackPanel>

				
				<Button Grid.Column="0" 
						Grid.Row="9"
						HorizontalAlignment="Center"
						Foreground="Wheat"
						Background="Red"
						IsVisible="false">
					Ошибка Smart
				</Button>

				<Button Grid.Column="1"
						Grid.Row="9"
						HorizontalAlignment="Center"
						Foreground="Wheat"
						Background="Red"
						IsVisible="false">
					Нет принтера
				</Button>







			</Grid>
			
			
			
		</Grid>


		<!-- НИЗ - кнопки -->
		<Grid ColumnDefinitions="*, *, *, *" 
			  ShowGridLines="false">
			
			<!--  Кнопка 1-->
			<Button Padding="15" 
					Grid.Column="0" 
					Content="Кнопка 1" 
					HorizontalAlignment="Center"
					Command="{Binding ClickButton1}"/>

			<!--  Кнопка 2-->
			<Button Padding="15"  
					Grid.Column="1" 
					Content="Кнопка 2" 
					HorizontalAlignment="Center"/>

			<!--  Кнопка 3-->
			<Button Padding="15" 
					Grid.Column="2" 
					Content="Кнопка 3" 
					HorizontalAlignment="Center"/>

			<!--  Кнопка 4-->
			<Button Padding="15"  
					Grid.Column="3" 
					Content="Кнопка 4" 
					HorizontalAlignment="Center"/>
		</Grid>
		
	</StackPanel>
	
</UserControl>
