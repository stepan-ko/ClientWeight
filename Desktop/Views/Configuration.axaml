<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:ClientCW.ViewModels"             
             x:Class="ClientCW.Views.Configuration"
			 x:DataType="vm:ConfigurationViewModel">
 
  
	  <StackPanel>

        <TabControl Grid.Row="0">
            <!--
           <ItemsControl ItemsSource="{Binding ConfigParameters}">    
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="20">

                            <TextBlock Text="{Binding Name}"
                                       Width="200"/>

                            <TextBox Text="{Binding Value}"
                                       Width="200"/>

                            <TextBox Text="{Binding NewValue}"
                                     Width="200"/>
                            
                            <TextBox Text="{Binding Config.ScaleName}"
                                     Width="200"/>
                            
                            
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
        </ItemsControl>
        -->

           
			<TabItem Header="Основные" Margin="5">
				<DataGrid ItemsSource="{Binding ConfigMain}"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="All"
                          IsReadOnly="False">

                    <DataGrid.Columns>
						<DataGridTextColumn  Header="Параметр"
                                             Binding="{Binding Name}"
                                             IsReadOnly="True"/>
                        <DataGridTextColumn  Header="Значение"
                                             Binding="{Binding Value}"
                                             IsReadOnly="True"/>
                        <DataGridTextColumn  Header="Новое значение"
                                             Binding="{Binding NewValue}"
                                             IsReadOnly="False"/>

                    </DataGrid.Columns>
			
                </DataGrid>

			</TabItem>
			<TabItem Header="Дополнительные" >
				


			</TabItem>
			<TabItem Header="Сеть">
				<DataGrid ItemsSource="{Binding ConfigNetwork}"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="All"
                          IsReadOnly="False">

                    <DataGrid.Columns>
						<DataGridTextColumn  Header="Параметр"
                                             Binding="{Binding Name}"
                                             IsReadOnly="True"/>
                        <DataGridTextColumn  Header="Значение"
                                             Binding="{Binding Value}"
                                             IsReadOnly="True"/>
                        <DataGridTextColumn  Header="Новое значение"
                                             Binding="{Binding NewValue}"
                                             IsReadOnly="False"/>

                    </DataGrid.Columns>
			
                </DataGrid>
			</TabItem>
		
            

            
        </TabControl>
        

        <!-- Кнопка -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="10">
			
            <Button Content="Отменить изменения"
                    Command="{Binding ResetConfigCommand}"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Width="220"
                    Height="40"
                    Margin="10"/>

            <Button Content="Записать Конфигурацию"
                    Command="{Binding SaveConfigCommand}"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Width="220"
                    Height="40"
                    Margin="10"/>

        </StackPanel>
        

 </StackPanel>
  

</UserControl>
