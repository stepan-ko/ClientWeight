<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:ClientCW.ViewModels"             
             x:Class="ClientCW.Views.Settings"
			 x:DataType="vm:SettingsViewModel">
 
  
	   <Grid Margin="16">
            <!-- Настройка строк: Auto под размер контента, * растягивает свободное место (если нужно) -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/> <!-- Для кнопок -->
            </Grid.RowDefinitions>

            <!-- Настройка колонок: фиксированная ширина для лейблов, остальное для контролов -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Modbus Host -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       VerticalAlignment="Center"    
                       Margin="0,10,0,0"
                       Text="IP-адрес весов"/>
            
           <TextBox Grid.Row="0" Grid.Column="1"
                     VerticalAlignment="Center"
                     Margin="0,10,0,0"
                     Classes="setting-value"                    
                     Text="{Binding Settings.Current.ModbusHost, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="15"/>

            <!-- Modbus Local Host -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="0,10,0,0"
                       Text="IP-адрес локальный"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     VerticalAlignment="Center"
                     Margin="0,10,0,0"
                     Classes="setting-value"
                     Text="{Binding Settings.Current.ModbusLocalHost, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="15" />

            <!-- Modbus Unit ID -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="0,10,0,0"
                       Text="Modbus ID"/>
            <NumericUpDown Grid.Row="2" Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="0,10,0,0"
                           Classes="setting-value"
                           Value="{Binding Settings.Current.ModbusUnitId}"
                           Minimum="0" Maximum="255" FormatString="F0"/>

            <!-- Reconnect Delay Seconds -->
            <TextBlock Grid.Row="3" Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="0,10,0,0"
                       Text="Повторное подключение, сек."/>
            <NumericUpDown Grid.Row="3" Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="0,10,0,0"
                           Classes="setting-value"
                           Value="{Binding Settings.Current.ReconnectDelaySeconds}"
                           Minimum="1" Maximum="300" FormatString="F0"/>

            <!-- Кнопки (занимает всю ширину, выровнены вправо) -->            
            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="Сбросить к исходным"
                        Command="{Binding ResetCommand}"
                        IsEnabled="{Binding CanSave}"
                        ToolTip.Tip="Показать актуальные настройки"
                        Grid.Column="0"/>

                <Button Content="Сохранить настройки"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        ToolTip.Tip="Сохранить изменения"
                        Grid.Column="1"/>
            </Grid>
        </Grid>
  

</UserControl>
